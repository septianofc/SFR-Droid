<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_2x2_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/sfr_logo"
            android:contentDescription="SFR Droid" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="SFR Droid"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_2x2_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 AKTIF"
            android:textColor="#4CAF50"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="#334155" />

    <TextView
        android:id="@+id/widget_2x2_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📡 0 Terkirim"
        android:textColor="#90CAF9"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_2x2_uptime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="⏱️ 00:00:00"
        android:textColor="#CBD5E1"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/widget_2x2_toggle_btn"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:backgroundTint="#42A5F5"
        android:text="STOP / MULAI"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
