<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_1x1_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <ImageView
        android:id="@+id/widget_1x1_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/sfr_logo"
        android:contentDescription="SFR Droid" />

    <TextView
        android:id="@+id/widget_1x1_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="● STANDBY"
        android:textColor="#4CAF50"
        android:textSize="9sp"
        android:textStyle="bold" />

</LinearLayout>
